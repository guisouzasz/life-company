# Banco de dados PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/studio_db"

# JWT — troque por um valor longo e aleatório em produção
JWT_SECRET="troque-este-valor"

# App
PORT=3000
# Em "production" o Swagger (/api/docs) fica desabilitado.
NODE_ENV=development
# Base dos links de primeiro acesso enviados aos alunos. Em produção precisa
# ser a URL pública do app (ex: https://life-company.vercel.app), senão o
# link copiado no painel do admin sai apontando para localhost.
APP_URL="http://localhost:8081"

# Origens do app web autorizadas no CORS, separadas por vírgula. Vazio usa o
# padrão do código (domínio de produção + localhost do Expo).
CORS_ORIGINS=""

# Firebase (opcional - para notificações push)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# E-mail (opcional - para recuperação de senha)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
