# Modelo do .env do backend. Copie para `backend/.env` e preencha para rodar
# na sua máquina — o arquivo real fica fora do Git.
#
# Em produção nada disto é lido de arquivo: os valores vivem nas Variables do
# serviço no Railway, e só DATABASE_URL e JWT_SECRET são de fato obrigatórios.
# O resto tem padrão no próprio código.

# Banco de dados PostgreSQL. No Railway, prefira a referência
# ${{Postgres.DATABASE_URL}} — ela usa o host interno, sem passar pela internet.
DATABASE_URL="postgresql://postgres:password@localhost:5432/studio_db"

# JWT — troque por um valor longo e aleatório em produção
JWT_SECRET="troque-este-valor"

# App
PORT=3000
NODE_ENV=development
# Documentação da API em /api/docs. Fica DESLIGADA por padrão porque expõe o
# mapa completo da API — ligue só na sua máquina.
# SWAGGER_DOCS=1
# Base dos links de primeiro acesso enviados aos alunos.
# Endereço local aqui é RECUSADO pelo código (um link para localhost não abre
# no celular do aluno) e substituído pelo domínio público do estúdio. Para
# testar o fluxo na própria máquina, use APP_URL_LOCAL=1 junto.
APP_URL="https://www.academialifecompany.com.br"
# APP_URL_LOCAL=1

# Origens do app web autorizadas no CORS, separadas por vírgula. Vazio usa o
# padrão do código (domínio de produção + localhost do Expo).
CORS_ORIGINS=""

# Firebase (opcional - para notificações push)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Seed (npm run prisma:seed) — sem senha embutida no código.
# SEED_ADMIN_SENHA é obrigatória; rodar contra banco remoto exige SEED_FORCAR=1;
# SEED_EXEMPLO=1 cria a aluna fictícia (nunca use em banco de verdade).
# SEED_ADMIN_SENHA=""
# SEED_ADMIN_EMAIL="admin@studio.com"

# E-mail (opcional - para recuperação de senha)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
