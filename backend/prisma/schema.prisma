generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoUsuario {
  ADMIN
  ALUNO
  PROFESSOR
}

enum DiaSemana {
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
}

enum StatusAgendamento {
  CONFIRMADO
  CANCELADO
  REALIZADO
  FALTOU
}

enum FormaPagamento {
  PIX
  DINHEIRO
  CARTAO
  OUTRO
}

model Usuario {
  id                    String      @id @default(uuid())
  nome                  String
  cpf                   String      @unique
  email                 String?     @unique
  telefone              String?
  // Ficha cadastral preenchida pelo admin. Opcionais no banco porque os
  // cadastros anteriores a este campo não os têm; o service exige no ALUNO.
  rg                    String?
  endereco              String?
  cep                   String?
  dataNascimento        DateTime?   @map("data_nascimento")
  senhaHash             String?     @map("senha_hash")
  tipoUsuario           TipoUsuario @default(ALUNO) @map("tipo_usuario")
  ativo                 Boolean     @default(true)
  fcmToken              String?     @map("fcm_token")
  // Financeiro: valor personalizado (override do preço do plano) e dia do vencimento
  valorMensalidade      Decimal?    @map("valor_mensalidade") @db.Decimal(10, 2)
  diaVencimento         Int         @default(5) @map("dia_vencimento")
  // Modalidade do PROFESSOR: limita a agenda e os treinos que ele gerencia
  modalidadeProfessorId String?     @map("modalidade_professor_id")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  agendamentos        Agendamento[]
  usuarioPlanos       UsuarioPlano[]
  primeiroAcesso      PrimeiroAcesso?
  refreshTokens       RefreshToken[]
  creditosReposicao   CreditoReposicao[]
  horariosFixos       HorarioFixo[]
  pagamentos          Pagamento[]
  treinosRecebidos    Treino[]           @relation("TreinosDoAluno")
  treinosCriados      Treino[]           @relation("TreinosDoProfessor")
  cargasRecebidas     RegistroCarga[]    @relation("CargasDoAluno")
  cargasRegistradas   RegistroCarga[]    @relation("CargasDoProfessor")
  treinosDia          TreinoDia[]        @relation("TreinosDiaDoProfessor")
  anamnese            Anamnese?
  aceitesTermo        AceiteTermo[]
  modalidadeProfessor Modalidade?        @relation("ProfessorModalidade", fields: [modalidadeProfessorId], references: [id])

  @@map("usuarios")
}

/// Aceite do termo de normas, gravado no primeiro acesso do aluno.
///
/// Guarda a VERSÃO aceita, não só a data: o texto muda com o tempo, e sem a
/// versão não dá para dizer qual redação a pessoa leu. Uma linha por versão —
/// se o estúdio publicar um termo novo e pedir aceite de novo, o histórico
/// anterior continua de pé.
model AceiteTermo {
  id        String   @id @default(uuid())
  usuarioId String   @map("usuario_id")
  versao    String
  aceitoEm  DateTime @default(now()) @map("aceito_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, versao])
  @@map("aceites_termo")
}

/// Ficha de anamnese do aluno: uma por pessoa, preenchida por ela mesma no
/// primeiro acesso (ou depois, pelo perfil) e lida por professor e admin.
model Anamnese {
  id        String @id @default(uuid())
  usuarioId String @unique @map("usuario_id")

  objetivo        String? // Emagrecimento, Hipertrofia, Condicionamento...
  nivelAtividade  String? // Sedentário, Já treinei, Treino regularmente
  problemasSaude  String? // hipertensão, diabetes, cardíaco... (texto livre)
  lesoes          String? // lesões e cirurgias
  dores           String? // dores articulares / coluna
  medicamentos    String?
  alergias        String?
  gestante        Boolean @default(false)
  fumante         Boolean @default(false)
  liberacaoMedica Boolean @default(false) // tem atestado/liberação médica
  observacoes     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("anamneses")
}

// Treino montado pelo professor para um aluno (área do professor).
model Treino {
  id           String    @id @default(uuid())
  alunoId      String    @map("aluno_id")
  professorId  String    @map("professor_id")
  modalidadeId String?   @map("modalidade_id") // modalidade do professor que montou
  titulo       String // ex: "Treino A — Superiores"
  // Treino em texto livre (Funcional/Pilates): blocos de tempo/intervalo
  // escritos como o professor preferir. Musculação usa exercicios[] + carga.
  conteudo     String?
  observacoes  String?
  // Metadados da ficha (todos opcionais)
  vencimento   DateTime? // até quando a ficha vale (renovar depois)
  frequencia   String? // "2x por semana"
  // Legado: saíram da ficha e não são mais gravados. Colunas mantidas para
  // não migrar o banco em produção.
  pausaSeries  String?
  velocidade   String?
  concluido    Boolean   @default(false) // ficha arquivada (Concluída)
  ativo        Boolean   @default(true) // soft-delete
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  aluno      Usuario           @relation("TreinosDoAluno", fields: [alunoId], references: [id])
  professor  Usuario           @relation("TreinosDoProfessor", fields: [professorId], references: [id])
  modalidade Modalidade?       @relation(fields: [modalidadeId], references: [id])
  exercicios ExercicioTreino[]

  @@map("treinos")
}

// Treino do DIA (Funcional): um treino por modalidade+data, igual para
// todas as aulas do dia — não é por aluno.
model TreinoDia {
  id           String   @id @default(uuid())
  professorId  String   @map("professor_id")
  modalidadeId String   @map("modalidade_id")
  data         DateTime // dia do treino (00:00)
  conteudo     String // texto livre, como o professor escreve
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  professor  Usuario    @relation("TreinosDiaDoProfessor", fields: [professorId], references: [id])
  modalidade Modalidade @relation(fields: [modalidadeId], references: [id])

  @@unique([modalidadeId, data])
  @@map("treinos_dia")
}

// Carga levantada pelo aluno num exercício, registrada pelo professor.
// NÃO aponta para ExercicioTreino: editar um treino recria os exercícios
// (deleteMany+create), o que apagaria o histórico. A identidade é
// (aluno + nome do exercício + modalidade), então a evolução sobrevive a
// qualquer alteração/recriação do treino.
model RegistroCarga {
  id           String   @id @default(uuid())
  alunoId      String   @map("aluno_id")
  professorId  String   @map("professor_id")
  modalidadeId String?  @map("modalidade_id")
  exercicio    String // nome do exercício, como aparece no treino
  peso         Decimal  @db.Decimal(6, 2) // em kg
  repeticoes   String? // "12", "10-12", "até a falha"...
  observacao   String?
  data         DateTime @default(now()) // dia do treino
  createdAt    DateTime @default(now()) @map("created_at")

  aluno      Usuario     @relation("CargasDoAluno", fields: [alunoId], references: [id])
  professor  Usuario     @relation("CargasDoProfessor", fields: [professorId], references: [id])
  modalidade Modalidade? @relation(fields: [modalidadeId], references: [id])

  @@index([alunoId, exercicio])
  @@map("registros_carga")
}

model ExercicioTreino {
  id         String  @id @default(uuid())
  treinoId   String  @map("treino_id")
  ordem      Int     @default(0)
  grupo      String? // grupo muscular: "Pernas", "Peitoral", "Costas"...
  nome       String
  series     Int     @default(3)
  repeticoes String  @default("12") // "12", "10-12", "até a falha"...
  carga      String? // "20kg", "elástico forte"...
  observacao String?

  treino Treino @relation(fields: [treinoId], references: [id], onDelete: Cascade)

  @@map("exercicios_treino")
}

model Plano {
  id            String   @id @default(uuid())
  nome          String
  aulasSemanais Int      @map("aulas_semanais")
  precoPadrao   Decimal? @map("preco_padrao") @db.Decimal(10, 2)

  usuariosPlano UsuarioPlano[]

  @@map("planos")
}

// Registro manual de mensalidade paga (sem valores — só pagou/não pagou no mês).
model Pagamento {
  id             String         @id @default(uuid())
  usuarioId      String         @map("usuario_id")
  valor          Decimal        @default(0) @db.Decimal(10, 2) // não usado na UI; mantido por histórico
  referencia     DateTime // competência: 1º dia do mês a que o pagamento se refere
  pagoEm         DateTime       @default(now()) @map("pago_em")
  formaPagamento FormaPagamento @default(PIX) @map("forma_pagamento")
  observacao     String?
  createdAt      DateTime       @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, referencia])
  @@map("pagamentos")
}

model Modalidade {
  id   String @id @default(uuid())
  nome String @unique

  horarios      Horario[]
  usuariosPlano UsuarioPlano[]
  professores   Usuario[]       @relation("ProfessorModalidade")
  treinos       Treino[]
  cargas        RegistroCarga[]
  treinosDia    TreinoDia[]

  @@map("modalidades")
}

model Horario {
  id               String    @id @default(uuid())
  modalidadeId     String    @map("modalidade_id")
  diaSemana        DiaSemana @map("dia_semana")
  horaInicio       String    @map("hora_inicio")
  horaFim          String    @map("hora_fim")
  capacidadeMaxima Int       @default(4) @map("capacidade_maxima")
  ativo            Boolean   @default(true)

  modalidade    Modalidade    @relation(fields: [modalidadeId], references: [id])
  agendamentos  Agendamento[]
  horariosFixos HorarioFixo[]

  @@map("horarios")
}

model HorarioFixo {
  id         String    @id @default(uuid())
  usuarioId  String    @map("usuario_id")
  horarioId  String    @map("horario_id")
  dataInicio DateTime  @map("data_inicio")
  dataFim    DateTime? @map("data_fim")
  ativo      Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  horario Horario @relation(fields: [horarioId], references: [id])

  @@unique([usuarioId, horarioId])
  @@map("horarios_fixos")
}

model UsuarioPlano {
  id                String    @id @default(uuid())
  usuarioId         String    @map("usuario_id")
  planoId           String    @map("plano_id")
  modalidadeId      String    @map("modalidade_id")
  vigenciaInicio    DateTime  @map("vigencia_inicio")
  vigenciaFim       DateTime? @map("vigencia_fim")
  aulasUsadasSemana Int       @default(0) @map("aulas_usadas_semana")
  semanaReferencia  DateTime  @map("semana_referencia")

  usuario    Usuario    @relation(fields: [usuarioId], references: [id])
  plano      Plano      @relation(fields: [planoId], references: [id])
  modalidade Modalidade @relation(fields: [modalidadeId], references: [id])

  @@map("usuario_planos")
}

model Agendamento {
  id        String            @id @default(uuid())
  usuarioId String            @map("usuario_id")
  horarioId String            @map("horario_id")
  dataAula  DateTime          @map("data_aula")
  status    StatusAgendamento @default(CONFIRMADO)
  reposicao Boolean           @default(false) // agendado usando crédito de reposição
  creditoId String?           @map("credito_id") // crédito consumido, se reposição
  createdAt DateTime          @default(now()) @map("created_at")

  usuario  Usuario   @relation(fields: [usuarioId], references: [id])
  horario  Horario   @relation(fields: [horarioId], references: [id])
  presenca Presenca?

  @@unique([usuarioId, horarioId, dataAula])
  @@map("agendamentos")
}

model CreditoReposicao {
  id                  String    @id @default(uuid())
  usuarioId           String    @map("usuario_id")
  origemAgendamentoId String?   @map("origem_agendamento_id") // aula cancelada que gerou (null = concedido pelo admin)
  criadoEm            DateTime  @default(now()) @map("criado_em")
  expiraEm            DateTime  @map("expira_em") // 45 dias a partir da data da aula cancelada
  usado               Boolean   @default(false)
  usadoEm             DateTime? @map("usado_em")
  usadoAgendamentoId  String?   @map("usado_agendamento_id") // aula agendada com este crédito
  revogado            Boolean   @default(false) // admin removeu
  concedidoAdmin      Boolean   @default(false) @map("concedido_admin")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("creditos_reposicao")
}

model Presenca {
  id            String   @id @default(uuid())
  agendamentoId String   @unique @map("agendamento_id")
  compareceu    Boolean  @default(false)
  registradoEm  DateTime @default(now()) @map("registrado_em")

  agendamento Agendamento @relation(fields: [agendamentoId], references: [id])

  @@map("presencas")
}

model PrimeiroAcesso {
  id        String   @id @default(uuid())
  usuarioId String   @unique @map("usuario_id")
  token     String   @unique @default(uuid())
  expiraEm  DateTime @map("expira_em")
  usado     Boolean  @default(false)

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("primeiro_acesso")
}

model RefreshToken {
  id        String   @id @default(uuid())
  usuarioId String   @map("usuario_id")
  token     String   @unique
  expiraEm  DateTime @map("expira_em")
  revogado  Boolean  @default(false)

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("refresh_tokens")
}
